{
  "name": "@repopilot/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm build && node --env-file-if-exists=../../.env dist/db/migrate.js",
    "seed": "pnpm build && node --env-file-if-exists=../../.env dist/seed.js",
    "openapi": "node dist/openapi.js",
    "test": "node --experimental-vm-modules test/run-jest.cjs --config jest.config.cjs --runInBand",
    "test:integration": "node --env-file-if-exists=../../.env --experimental-vm-modules test/run-jest.cjs --config jest.integration.cjs --runInBand",
    "eval": "pnpm build && node --env-file-if-exists=../../.env dist/evaluate.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/pg": "8.15.6",
    "@types/jest": "30.0.0",
    "@types/supertest": "6.0.3",
    "drizzle-kit": "0.31.11",
    "jest": "30.5.2",
    "supertest": "7.2.2",
    "ts-jest": "29.4.14"
  }
}
