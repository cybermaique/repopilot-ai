  "info": {
    "title": "RepoPilot AI local demo",
    "description": "Fixed local workspace. Deterministic Demo provider only; production startup is refused.",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "database": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "ErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "message"
        ]
      },
      "RegisterRepositoryDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "fixture"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "RepositoryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "fixture"
            ]
          },
          "activeSnapshotId": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "workspaceId",
          "name",
          "kind",
          "activeSnapshotId",
          "createdAt"
        ]
      },
      "SnapshotDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "repositoryId": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "fileCount": {
            "type": "number"
          },
          "chunkCount": {
            "type": "number"
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "workspaceId",
          "repositoryId",
          "revision",
          "fileCount",
          "chunkCount",
          "diagnostics",
          "createdAt"
        ]
      },
      "IndexRunStatusDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "status",
          "error"
        ]
      },
      "RepositoryDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "fixture"
            ]
          },
          "activeSnapshotId": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "snapshots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SnapshotDto"
            }
          },
          "lastIndexRun": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/IndexRunStatusDto"
              }
            ]
          }
        },
        "required": [
          "id",
          "workspaceId",
          "name",
          "kind",
          "activeSnapshotId",
          "createdAt",
          "snapshots",
          "lastIndexRun"
        ]
      },
      "FindingDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "text",
          "sourceIds"
        ]
      },
      "SourceDto": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "snapshotId": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "startLine": {
            "type": "number"
          },
          "endLine": {
            "type": "number"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "sourceId",
          "snapshotId",
          "path",
          "revision",
          "startLine",
          "endLine",
          "content"
        ]
      },
      "AnswerDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "demo"
            ]
          },
          "evidence": {
            "type": "string",
            "enum": [
              "supported",
              "insufficient"
            ]
          },
          "summary": {
            "type": "string"
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FindingDto"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceDto"
            }
          },
          "durationMs": {
            "type": "number"
          },
          "limitation": {
            "type": "string"
          }
        },
        "required": [
          "provider",
          "evidence",
          "summary",
          "findings",
          "sources",
          "durationMs",
          "limitation"
        ]
      },
      "IndexResultDto": {
        "type": "object",
        "properties": {
          "snapshotId": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "fileCount": {
            "type": "number"
          },
          "chunkCount": {
            "type": "number"
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reused": {
            "type": "boolean"
          }
        },
        "required": [
          "snapshotId",
          "revision",
          "fileCount",
          "chunkCount",
          "diagnostics",
          "reused"
        ]
      },
      "RunDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "repositoryId": {
            "type": "string"
          },
          "snapshotId": {
            "type": "string",
            "nullable": true
          },
          "conversationId": {
            "type": "string",
            "nullable": true
          },
          "kind": {
            "type": "string",
            "enum": [
              "index",
              "question"
            ]
          },
          "question": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "cancelRequested": {
            "type": "boolean"
          },
          "answer": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/AnswerDto"
              }
            ]
          },
          "indexResult": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/IndexResultDto"
              }
            ]
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "repositoryId",
          "snapshotId",
          "conversationId",
          "kind",
          "question",
          "status",
          "cancelRequested",
          "answer",
          "indexResult",
          "error",
          "createdAt",
          "finishedAt"
        ]
      },
      "EventDto": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "number"
          },
          "type": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "sequence",
          "type",
          "message",
          "createdAt"
        ]
      },
      "CreateRunDto": {
        "type": "object",
        "properties": {
          "repositoryId": {
            "type": "string",
            "format": "uuid"
          },
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 2
          }
        },
        "required": [
          "repositoryId",
          "question"
        ]
      }
    }
  }
}
