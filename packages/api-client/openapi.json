    "/api/runs/{id}/stream": {
      "get": {
        "description": "Persisted EventDto events named run, SSE id=sequence. Replay using Last-Event-ID or after. Terminal event closes stream. Browser disconnect does not cancel the run.",
        "operationId": "RunsController_stream",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "after",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE stream of JSON EventDto",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "",
        "tags": [
          "runs"
        ]
